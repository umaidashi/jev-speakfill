{
  "name": "jev-speakfill",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --format=esm --outfile=dist/eval.mjs --log-level=warning && node --env-file=.env dist/eval.mjs",
    "dev": "npm run build && node --env-file=.env dist/server.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.1",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
